{
  "name": "dog-boarding",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:requirements": "node scripts/check-requirements.js",
    "check:test-pii": "sh scripts/no-test-pii.sh --tracked-tests",
    "check:deploy": "node --env-file-if-exists=.env.local scripts/check-deploy.js",
    "seed": "node scripts/seed-test-data.js",
    "reset-db": "node scripts/reset-test-data.js",
    "seed:staging": "VITE_ENVIRONMENT=staging node scripts/seed-test-data.js",
    "test:smoke": "node scripts/smoke-test.js",
    "predeploy": "npm run test:run && npm run test:smoke",
    "reauth-gmail": "node scripts/get-gmail-refresh-token.js",
    "prepare": "husky",
    "mutate": "stryker run stryker.config.json"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.118.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "react-select": "^5.10.2",
    "satori": "0.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.64.11"
  }
}
