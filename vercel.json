{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-auth",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-schedule",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron-detail",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/cron-detail-2",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/ops-watch",
      "schedule": "0 17 * * *"
    }
  ],
  "functions": {
    "api/ops-watch.js": {
      "maxDuration": 60
    }
  }
}
