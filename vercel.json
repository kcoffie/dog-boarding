{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-auth",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-schedule",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron-detail",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/cron-detail-2",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/ops-watch",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 22 * * 5"
    },
    {
      "path": "/api/notify",
      "schedule": "0 23 * * 5"
    },
    {
      "path": "/api/notify",
      "schedule": "0 0 * * 6"
    }
  ],
  "functions": {
    "api/ops-watch.js": {
      "maxDuration": 60
    },
    "api/notify.js": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/**": true
    }
  }
}
