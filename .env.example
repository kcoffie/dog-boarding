# Dog Boarding App Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file containing real credentials

# =============================================================================
# REQUIRED: Supabase Configuration (Client-side)
# =============================================================================
# Get these from your Supabase project: Settings > API

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon (public) key - safe to use in browser
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# OPTIONAL: Environment Identifier
# =============================================================================
# Values: development, staging, production
# Used by seed scripts to prevent accidental production data manipulation
VITE_ENVIRONMENT=development

# =============================================================================
# SCRIPTS ONLY: Service Role Key (Never expose to browser!)
# =============================================================================
# Only needed for running npm run seed or npm run reset-db
# Get from Supabase: Settings > API > service_role key
# WARNING: This key bypasses RLS - keep it secret!

# For local development, you can set these when running scripts:
#   SUPABASE_URL=https://xxx.supabase.co \
#   SUPABASE_SERVICE_ROLE_KEY=your-service-role-key \
#   npm run seed

# Or create a separate .env.seed file (don't commit it!):
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# OPTIONAL: External Sync (booking-site integration)
# =============================================================================
# NOTE: Do NOT use VITE_ prefix for credentials — non-VITE_ vars stay server-side only.
# Vite bakes VITE_* values into the JS bundle, which would expose them publicly.

# Login credentials for the booking site (server-side crons + sync-proxy only)
EXTERNAL_SITE_USERNAME=your-email@example.com
EXTERNAL_SITE_PASSWORD=your-password-here

# Supabase service role key — used by server-side crons to bypass RLS
# Get from Supabase: Settings > API > service_role key
# WARNING: This key bypasses Row Level Security — keep it secret!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server-only token for the jobs' endpoints (notify, roster-image, intraday-image) and check:deploy.
# Never prefix it with VITE_: that would build it into the public browser bundle (#301).
# Generate one: openssl rand -hex 32
INTERNAL_API_TOKEN=your-random-token-here

# Secret that Vercel sends in cron request headers. Required: without it every cron endpoint returns 401.
# Set this in the Vercel dashboard (and in .env.local to call the crons locally)
CRON_SECRET=your-cron-secret-here

# =============================================================================
# TEST ACCOUNTS (created by npm run seed)
# =============================================================================
# After running npm run seed, these accounts are available:
#   admin@test.com / TestPass123!
#   user1@test.com / TestPass123!
#   user2@test.com / TestPass123!
