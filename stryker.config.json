{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "api/**/*.js",
    "src/lib/**/*.js",
    "src/utils/**/*.js",
    "!**/*.test.js",
    "!**/__tests__/**"
  ],
  "ignorePatterns": [
    "docs",
    "logs",
    "out",
    "public",
    "supabase"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "out/mutation.html"
  },
  "jsonReporter": {
    "fileName": "out/mutation.json"
  },
  "timeoutMS": 20000,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 44
  }
}
